# MuniAudit-AI Environment Configuration Example

# Application Runtime
APP_NAME=MuniAudit-AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security / Authentication (Cognito / JWT)
SECRET_KEY=muniaudit_super_secret_local_development_key_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AWS_COGNITO_USER_POOL_ID=ap-south-1_examplepool
AWS_COGNITO_APP_CLIENT_ID=exampleappclientid

# Database (PostgreSQL 16 + PostGIS + pgvector)
DATABASE_URL=postgresql://muniaudit_admin:muniaudit_secure_password@localhost:5432/muniaudit_db

# Storage (Local Build-It vs AWS S3 Ship-It)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/evidence_storage
AWS_REGION=ap-south-1
AWS_S3_EVIDENCE_BUCKET=muniaudit-evidence-store-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Asynchronous Queue (SQS)
SQS_QUEUE_URL=
SQS_DLQ_URL=

# Verification Thresholds & Invariants
MASS_BALANCE_TOLERANCE_KG=20.0
MAX_SILT_DENSITY_T_M3=1.90
GEODESIC_SPEED_CEILING_KMH=80.0
SSCD_SIMILARITY_THRESHOLD=0.82
