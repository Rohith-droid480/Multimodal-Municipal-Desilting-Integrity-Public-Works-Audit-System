# MuniAudit-AI Frontend Environment Configuration
# SAFE LOCAL DEVELOPMENT DEFAULTS - NO SECRETS

# Next.js Application
NEXT_PUBLIC_APP_NAME="MuniAudit-AI"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_ENVIRONMENT="development"

# Backend API Endpoint (Alpha Foundation Boundary)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Feature Flags
NEXT_PUBLIC_USE_FIXTURES="true"
NEXT_PUBLIC_ENABLE_MAPS="false"
